source 'https://rubygems.org'

group :jekyll_plugins do
  gem 'jekyll'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jemoji'
  gem 'webrick', '~> 1.8'
end

gem 'github-pages'
gem 'connection_pool', '2.5.0'

# github-pages pins Jekyll 3.9, which requires these; they stopped being default gems in
# newer Rubies, so declare them explicitly for local builds. Harmless on GitHub Pages.
gem 'csv'
gem 'base64'
gem 'bigdecimal'
gem 'logger'
